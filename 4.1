#define _CRT_SECURE_NO_WARNINGS
#include <locale.h>
#include <stdio.h>
#include <stdlib.h>

void calculations()
{
    int a = 11;
    int b = 3;

    printf("a = %d\nb = %d\n", a, b);

    // Целочисленное деление (для сравнения)
    printf("int (a/b) = %d\n", a / b);

    // Явное преобразование и вывод float и double
    printf("(float)a/b = %.5f\n", (float)a / b);
    printf("(double)a/b = %.5e\n", (double)a / b);

    printf("\nЭксперименты со скобками:\n");
    printf("(float)(a/b) = %.5f\n", (float)(a / b));      // сначала int-деление, потом приведение
    printf("a/(float)b = %.5f\n", a / (float)b);         // один операнд float → результат float
    printf("(float)a/(float)b = %.5f\n", (float)a / (float)b); // оба операнда float
}

int main()
{
    setlocale(LC_ALL, "Russian");

    calculations();

    return 0;
}
